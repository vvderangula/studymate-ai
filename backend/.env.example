# StudyMate backend: secrets and per-deployment values only.
# Every other setting is a code default in app/core/config/settings.py.

ENVIRONMENT=development

# MongoDB connection string (database "studymate" unless the URI names one)
MONGODB_URI=

# Google Gemini API key (embeddings + answers)
GEMINI_API_KEY=

# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated emails that get the admin role
ADMIN_EMAILS=

# Comma-separated origins, or * to allow any
CORS_ORIGINS=*
